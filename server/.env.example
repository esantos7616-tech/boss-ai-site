# Boss AI backend config. Copy to .env and fill in what you have.
# Every provider below is FREE (no credit card needed for most). Each one you
# add unlocks more of the 30 models. Leave a line blank to skip that provider.

# Google AI Studio: 3 Gemini models (default supervisor). https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Groq: 7 models, very fast. https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter: 8 ":free" models, plus auto-discovery of new free ones. https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Cerebras: 2 models. https://cloud.cerebras.ai
CEREBRAS_API_KEY=
# Mistral "Experiment" free plan: 3 models. https://console.mistral.ai/api-keys
MISTRAL_API_KEY=
# GitHub Models: 3 models. Fine-grained token with "Models: read". https://github.com/settings/tokens
GITHUB_TOKEN=
# Cloudflare Workers AI: 2 models (free daily allowance). https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Ollama: 2 local models running on the Pi itself (offline fallback). Install ollama first.
# OLLAMA_URL=http://localhost:11434

# --- Security: REQUIRED once your tunnel is public. Any long random string.
# Enter the same value in the website's Settings drawer.
BOSS_ACCESS_KEY=
# Comma-separated sites allowed to call the API, e.g. https://esantos7616-tech.github.io
ALLOWED_ORIGINS=*

# --- Tuning
PORT=3000
# Agents (each on its own model) working on each question. More = better cross-checking, more quota used.
WORKERS_PER_QUERY=4
# Cap on how many agents the team may create.
MAX_AGENTS=150
# Force a supervisor (model id from models.json). Leave blank to pick the lowest measured hallucination rate.
SUPERVISOR_MODEL=
# Set to 0 to stop auto-adding new free OpenRouter models.
AUTO_DISCOVER=1
DISCOVER_MAX=20
# Set to 0 to disable live stock data (Yahoo Finance / Stooq).
MARKET_DATA=1
